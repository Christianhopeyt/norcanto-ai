{
  "name": "Norcanto AI Document Workspace",
  "short_name": "Norcanto AI",
  "description": "Analyze documents, review risks, deadlines, and action items.",
  "start_url": "/pages/app.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0A0A0B",
  "theme_color": "#0A0A0B",
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    { "action": "/pages/app.html?upload=1", "accept": { "application/pdf": [".pdf"], "text/plain": [".txt"] } }
  ],
  "share_target": {
    "action": "/pages/app.html?upload=1",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
